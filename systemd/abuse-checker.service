[Unit]
Description=AbuseIPDB abuse checker for monitored IPs/subnets
Documentation=file:///usr/local/share/doc/abuse-checker/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=abusechecker
Group=abusechecker
# Secrets are provided by the generated drop-in
# abuse-checker.service.d/10-secrets.conf (LoadCredentialEncrypted= for
# systemd-creds, or LoadCredential= of the OpenSSL master key).
ExecStart=/usr/local/bin/abuse-checker --run
TimeoutStartSec=30min
Nice=10

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0027
ReadWritePaths=/var/lib/abuse-checker
