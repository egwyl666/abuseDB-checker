# /etc/abuse-checker/secrets.conf  (root:root 0600)
# Read by systemd (EnvironmentFile=) and by abuse-checker when run as root.
# Use plain KEY="value" lines only: no $variables, no command substitution.

# --- AbuseIPDB -------------------------------------------------------------
# One or more keys, comma-separated. Failover on HTTP 429/401/403 or when
# X-RateLimit-Remaining hits 0.
ABUSEIPDB_API_KEYS=""

# Alert when abuseConfidenceScore > THRESHOLD or totalReports > 0.
THRESHOLD="25"
MAX_AGE_DAYS="30"
# true: CIDRs use /api/v2/check-block. false: IPv4 CIDRs with at most
# EXPAND_MAX_HOSTS addresses are expanded and checked IP by IP.
USE_CHECK_BLOCK="true"
EXPAND_MAX_HOSTS="256"
# Seconds to sleep between API calls (0 = none).
REQUEST_DELAY="0"

# --- Reports ---------------------------------------------------------------
RETENTION_DAYS="30"
# Name shown in alerts and reports (defaults to hostname).
#HOST_LABEL="vps-01"

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
# Personal chats and groups, comma-separated (groups are negative ids).
TELEGRAM_CHAT_IDS=""

# --- Slack -----------------------------------------------------------------
# Incoming webhook URLs, comma-separated.
SLACK_WEBHOOK_URLS=""

# --- Email -----------------------------------------------------------------
EMAIL_TO=""
EMAIL_FROM=""
# smtps://host:465 (implicit TLS) or smtp://host:587 (STARTTLS is required).
# Leave SMTP_URL empty to fall back to the local sendmail binary.
SMTP_URL=""
SMTP_USER=""
SMTP_PASS=""
